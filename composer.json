{
  "name": "z-trippete/jwt-verifier",
  "description": "Library for jwt token verifier",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "lcobucci/jwt": "^5.0",
    "guzzlehttp/guzzle": "^7.0",
    "psr/clock": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "ZTrippete\\JwtVerifier\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ZTrippete\\JwtVerifier\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
